{
    "$schema": "https://typedoc.org/schema.json",
    "entryPoints": ["src/index.ts"],
    "tsconfig": "tsconfig.lib.json",
    "name": "@ezclassify/schemes API reference",
    "readme": "docs/API.md",
    "out": "docs/api",
    "excludePrivate": true,
    "excludeProtected": true,
    "excludeInternal": true,
    "treatWarningsAsErrors": true,
    "validation": {
        "notExported": true,
        "invalidLink": true,
        "notDocumented": true
    },
    "disableSources": true
}

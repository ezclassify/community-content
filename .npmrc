# npm supply-chain hardening: never run dependency install/lifecycle scripts.
ignore-scripts=true

# The publish-date quarantine for third-party packages is NOT configured here.
# npm's `min-release-age` is tree-wide with no supported way to exempt a scope
# (`min-release-age-exclude` is not an npm setting; npm reports it as an
# unknown project config and ignores it). Setting the window in this file
# therefore quarantines our own freshly published packages too, and `npm ci`
# fails with ETARGET on every @ezclassify dependency. The window belongs on
# third-party intake, where first-party packages can be told apart, so it is
# enforced by `scripts/check-dependency-age.mjs` (npm run check:dependency-age)
# instead, which reads the lockfile and exempts @ezclassify packages by name.
